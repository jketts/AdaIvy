  "claims": [
    {
      "claim_id": "cl.graffiti-322-counterexample",
      "prose_statement": "The connected triangle-free graph G(14,18) has Inverse Even 40049/4444 and exactly nine distinct distance eigenvalues, so under the enumerated reading (even_includes_v, range_distinct_count) it is a candidate counterexample to Graffiti 322. Under the range_extent reading of the same conjecture it is not, and the previously published C4 candidate is a candidate under (even_excludes_v, range_distinct_count). Which reading is the source's is not decided here.",
      "latex_statement": "\\operatorname{InvEven}(G_{14,18})=\\frac{40049}{4444}>9=\\lvert\\operatorname{spec}(D(G_{14,18}))\\rvert",
      "lean_statement": ": (14 * 14 + 14 * 18 : Nat) = 448 ∧ (3 * 14 * 13 / 2 + 14 * 18 : Nat) = 525 ∧ (1 + 13 * 13 + 13 * 18 : Nat) = 404 ∧ (3 * 14 - 4 + 18 : Nat) = 56 ∧ (2 * 14 - 2 + 18 : Nat) = 44 ∧ (3 + 4 * 13 + (14 * 14 - 3 * 14 + 1) + 14 * 17 : Nat) = 448 ∧ (9 * 4444 : Nat) = 39996 ∧ (40049 - 39996 : Nat) = 53 ∧ ¬ ((40049 : Nat) ≤ 9 * 4444)",
      "representation_id": "rep.graffiti-322-partial-formalization.v1",
      "representation_status": "partially_verified",
      "attestation_id": "att.graffiti-322-arithmetic",
      "certificate_id": "cert.graffiti-322-exact-separation",
      "certificate_role": "separates_values",
