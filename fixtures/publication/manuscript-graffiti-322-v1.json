          "readings": [
            {
              "reading_id": "even_includes_v",
              "statement": "Even(v) is the set of vertices at even distance from v and includes v itself, because distance zero is even. This is the reading AdaIvy froze for the Graffiti 322 report. No transcription of the defining page is recorded, so the reading is asserted rather than re-extractable.",
              "source_passage_ref": "psg.wow.even-definition",
              "reading_status": "asserted",
              "publication_restricted": false,
              "attributed_to": "adaivy"
            },
            {
              "reading_id": "even_excludes_v",
              "statement": "Even(v) is the set of vertices other than v at even distance from v, so v itself is not counted. This is the reading under which the previously published C4 candidate refutes Graffiti 322.",
              "source_passage_ref": "psg.wow.even-definition",
              "reading_status": "asserted",
              "publication_restricted": false,
              "attributed_to": "roucairol-cazenave"
            }
          ]
        },
        {
          "term_id": "range_meaning",
          "term": "range",
          "readings": [
            {
              "reading_id": "range_distinct_count",
              "statement": "The range of the distance spectrum is the number of distinct distance eigenvalues. The Graffiti 197 prior-resolution record is filed under this same meaning of range.",
              "source_passage_ref": "psg.wow.graffiti-322",
              "reading_status": "asserted",
              "publication_restricted": false,
              "attributed_to": null
            },
            {
              "reading_id": "range_extent",
              "statement": "The range of the distance spectrum is the extent lambda_max minus lambda_min. Under this meaning the G(14,18) evaluation does not refute Graffiti 322 at all.",
