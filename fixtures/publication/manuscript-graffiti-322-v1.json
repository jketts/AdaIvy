      "original_problem_citation_id": "cite.wow.graffiti-322",
      "derivation": {
        "status": "included",
        "summary": "Construct G(r,t) by replacing every edge of K(r) with a length-three path and attaching t leaves at each branch vertex. Classify the even-distance counts exactly, verify the supplied invariant-subspace decomposition against the graph's own distance matrix, and compare the exact rational Inverse Even value with the distinct eigenvalue count.",
        "citations": [
          "cite.wow.even-definition"
        ]
      },
