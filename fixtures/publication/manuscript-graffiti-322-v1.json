            "recheck.graffiti-322.prior-candidate.v1"
          ],
          "runs": [
            {
              "t": "text",
              "v": "A bounded pre-research literature search over the acquired corpus returned an inconclusive outcome, and a second, result-specific prior art classification was performed after the construction existed. Both are records in this bundle, and neither establishes that no earlier refutation exists."
            }
          ],
          "citations": []
        }
      ]
