  "terms": [
    {
      "readings": [
        {
          "attributed_to": "adaivy",
          "reading_id": "even_includes_v",
          "reading_status": "asserted",
          "source_passage_ref": "psg.wow.even-definition",
          "statement": "Even(v) is the set of vertices at even distance from v and includes v itself, because distance zero is even. This is the reading AdaIvy froze for the Graffiti 322 report."
        },
        {
          "attributed_to": "roucairol-cazenave",
          "reading_id": "even_excludes_v",
          "reading_status": "asserted",
          "source_passage_ref": "psg.wow.even-definition",
          "statement": "Even(v) is the set of vertices other than v at even distance from v, so v itself is not counted. This is the reading under which the previously published C4 candidate refutes Graffiti 322."
        }
      ],
      "term": "Even(v)",
      "term_id": "even_membership"
    },
    {
      "readings": [
        {
          "attributed_to": "roucairol-cazenave",
          "reading_id": "range_distinct_count",
          "reading_status": "transcribed",
          "source_passage_ref": "psg.wow.graffiti-322",
          "statement": "The range of the distance spectrum is the number of distinct distance eigenvalues. The Graffiti 197 prior-resolution record is filed under this same meaning of range, and AdaIvy separately re-asserted it in prose for Graffiti 322."
        },
        {
          "attributed_to": null,
          "reading_id": "range_extent",
          "reading_status": "transcribed",
          "source_passage_ref": "psg.roucairol-cazenave.graffiti-322",
          "statement": "The range of the distance spectrum is the extent lambda_max minus lambda_min. Under this meaning the Graffiti 322 result is false rather than merely unoriginal."
        }
      ],
      "term": "range",
      "term_id": "range_meaning"
    }
  ]
}
