# Copy to .env.settings, set permissions to 0600, and fill in locally.
#
#   cp .env.settings.example .env.settings && chmod 0600 .env.settings
#
# NON-SECRET, BUT STILL NOT COMMITTED. Every value here names one operator's
# account -- which Azure resource and deployment, which AWS region, which
# MiniMax group. None of it belongs in git, and none of it belongs in `.env`
# either: that file holds credentials only, so it stays the single thing to
# guard. A credential written here is a loader error, and so is a setting
# written in `.env`.
#
# These are not secrets, but they are not harmless. `AZURE_OPENAI_ENDPOINT` is
# the host your key is sent to, so whoever can rewrite this file can redirect
# the key. It therefore carries the same file controls as `.env`: regular file,
# no symlink, mode 0600 -- for integrity rather than confidentiality.
#
# Keep every value in this example BLANK.

# --- Azure OpenAI -----------------------------------------------------------
# ENDPOINT is the resource root only, e.g. https://<resource>.cognitiveservices.azure.com
# -- no path. The adapter appends /openai/deployments/<deployment>/chat/completions
# itself, so a root that already contains /openai/... builds a doubled URL.
# DEPLOYMENT is a single path segment and is what actually selects the model:
# the model named in a live run configuration does not steer the URL.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# --- AWS Bedrock ------------------------------------------------------------
# Required; requests fail closed without it. Never defaulted.
AWS_REGION=

# --- MiniMax ----------------------------------------------------------------
# Optional: some MiniMax deployments scope requests to a group id.
MINIMAX_GROUP_ID=
