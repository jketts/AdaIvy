# Copy to .env, set permissions to 0600, and replace the blank values locally.
# Never commit the populated .env file. `.gitignore` excludes `.env` and `.env.*`
# while allowing the two examples, so keep every value here BLANK.
#
#   cp .env.example .env && chmod 0600 .env
#
# SECRETS ONLY. This file holds credentials and nothing else, so there is exactly
# one file to keep out of git, off a backup, and off a screen share. The
# non-secret operational settings that used to live here -- Azure endpoint,
# deployment and api-version, AWS region, MiniMax group id -- now live in
# `.env.settings`; see `.env.settings.example`. Putting one of them here is a
# loader error naming the line and the file it belongs in, not a silent accept.
#
# Every key below is optional and read only at the live-provider boundary. The
# offline suite (`make check`) never reads these and never opens a socket, so an
# empty file is the correct state for ordinary development.

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=

# --- Anthropic --------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- DeepSeek ---------------------------------------------------------------
DEEPSEEK_API_KEY=

# --- MiniMax (MiniMax platform) --------------------------------------------
MINIMAX_API_KEY=

# --- Qwen (AliCloud DashScope) ---------------------------------------------
DASHSCOPE_API_KEY=

# --- Azure OpenAI -----------------------------------------------------------
# The key authenticates against the whole Azure resource, not one deployment,
# so a single key covers every deployment on that resource. Which deployment is
# called is a setting, not a secret: see `.env.settings.example`.
AZURE_OPENAI_API_KEY=

# --- AWS Bedrock ------------------------------------------------------------
# AWS_SESSION_TOKEN is only needed for temporary/STS credentials. The region is
# a setting, not a secret: see `.env.settings.example`.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
