# Copy to .env, set permissions to 0600, and replace the blank values locally.
# Never commit the populated .env file. `.gitignore` excludes `.env` and `.env.*`
# while allowing this example, so keep every value here BLANK.
#
#   cp .env.example .env && chmod 0600 .env
#
# Every key below is optional and read only at the live-provider boundary. The
# offline suite (`make check`) never reads these and never opens a socket, so an
# empty file is the correct state for ordinary development.

# --- OpenAI (existing) ------------------------------------------------------
OPENAI_API_KEY=

# --- Anthropic --------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- DeepSeek ---------------------------------------------------------------
DEEPSEEK_API_KEY=

# --- MiniMax (MiniMax platform) --------------------------------------------
MINIMAX_API_KEY=
# Optional: some MiniMax deployments scope requests to a group id.
MINIMAX_GROUP_ID=

# --- Qwen (AliCloud DashScope) ---------------------------------------------
DASHSCOPE_API_KEY=

# --- Azure OpenAI -----------------------------------------------------------
# Azure differs from the Bearer-token providers: it authenticates with an
# `api-key` header against a deployment-scoped URL and requires an api-version.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# --- AWS Bedrock ------------------------------------------------------------
# Region is required; requests fail closed without it. AWS_SESSION_TOKEN is
# only needed for temporary/STS credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=
