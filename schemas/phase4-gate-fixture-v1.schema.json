{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaivy.invalid/schemas/phase4-gate-fixture-v1.schema.json",
  "title": "AdaIvy nonproduction Phase 4 gate fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_id", "primary_class", "tags", "source", "rights", "lifecycle", "applicability", "expected"],
  "properties": {
    "schema_version": {"const": "adaivy.phase4-gate-fixture.v1"},
    "fixture_id": {"$ref": "#/$defs/id"},
    "primary_class": {"enum": ["applicable", "incompatible_hypotheses", "definition_mismatch", "scope_or_exception", "misquotation", "contradiction", "prompt_injection", "rights_or_takedown"]},
    "tags": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}},
    "source": {"$ref": "#/$defs/provenance_record"},
    "rights": {"$ref": "#/$defs/rights_decision"},
    "rights_history": {"type": "array", "minItems": 2, "maxItems": 64, "items": {"$ref": "#/$defs/rights_decision"}},
    "lifecycle": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/lifecycle_event"}},
    "applicability": {"$ref": "#/$defs/applicability_record"},
    "expected": {"$ref": "#/$defs/expected_result"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[a-z][a-z0-9_.-]+$"},
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "minLength": 20, "maxLength": 20, "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"},
    "nullable_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
    "nullable_timestamp": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
    "actor_type": {"enum": ["human", "automation", "model", "system"]},
    "authority": {"enum": ["source_provenance", "human_final", "proposal", "deterministic_policy"]},
    "use": {"enum": ["acquisition", "storage_and_retention", "parsing", "excerpting", "embedding", "model_context", "redistribution", "publication"]},
    "use_scope": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/use"}},
    "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "reason_detail": {"type": "string", "minLength": 1, "maxLength": 512},
    "applicability_status": {"enum": ["proposed", "checked", "rejected", "unresolved"]},
    "final_applicability_status": {"enum": ["checked", "rejected", "unresolved"]},
    "applicability_outcome": {"enum": ["checked", "applicable", "rejected", "unresolved", "not_applicable"]},
    "applicability_reason": {"enum": ["applicable", "incompatible_hypotheses", "definition_mismatch", "scope_or_exception", "misquotation", "contradiction", "insufficient_evidence", "rights_blocked", "source_withdrawn", "malicious_content"]},
    "rights_reason": {"enum": ["permitted", "explicitly_prohibited", "unknown_rights", "rights_expired", "rights_revoked", "rights_use_incompatible", "rights_corrected"]},
    "rights_values": {
      "type": "object", "additionalProperties": false, "maxProperties": 8,
      "properties": {
        "acquisition": {"enum": ["allowed", "prohibited", "unresolved"]}, "storage_and_retention": {"enum": ["allowed", "prohibited", "unresolved"]}, "parsing": {"enum": ["allowed", "prohibited", "unresolved"]}, "excerpting": {"enum": ["allowed", "prohibited", "unresolved"]}, "embedding": {"enum": ["allowed", "prohibited", "unresolved"]}, "model_context": {"enum": ["allowed", "prohibited", "unresolved"]}, "redistribution": {"enum": ["allowed", "prohibited", "unresolved"]}, "publication": {"enum": ["allowed", "prohibited", "unresolved"]}
      }
    },
    "provenance_record": {
      "type": "object", "additionalProperties": false,
      "required": ["provenance_id", "artifact_id", "text", "evidence_start", "evidence_end", "evidence_quote", "quarantined", "actor_id", "actor_type", "authority", "reason_code", "evidence_ids", "recorded_at", "version", "sequence"],
      "properties": {
        "provenance_id": {"$ref": "#/$defs/id"}, "artifact_id": {"$ref": "#/$defs/id"}, "text": {"type": "string", "maxLength": 2097152}, "evidence_start": {"type": "integer", "minimum": 0, "maximum": 2097152}, "evidence_end": {"type": "integer", "minimum": 0, "maximum": 2097152}, "evidence_quote": {"type": "string", "maxLength": 2097152}, "quarantined": {"type": "boolean"}, "actor_id": {"$ref": "#/$defs/id"}, "actor_type": {"const": "human"}, "authority": {"const": "source_provenance"}, "reason_code": {"const": "local_user_supplied"}, "evidence_ids": {"$ref": "#/$defs/evidence_ids"}, "recorded_at": {"$ref": "#/$defs/timestamp"}, "version": {"const": 1}, "sequence": {"type": "integer", "minimum": 0, "maximum": 256}
      }
    },
    "rights_decision": {
      "type": "object", "additionalProperties": false,
      "required": ["requested_use", "decisions", "use_scope", "valid_from", "valid_until", "actor_id", "actor_type", "authority", "reason_code", "reason", "evidence_id", "reviewed_at", "sequence", "version", "supersedes", "superseded_by"],
      "properties": {
        "requested_use": {"$ref": "#/$defs/use"}, "decisions": {"$ref": "#/$defs/rights_values"}, "use_scope": {"$ref": "#/$defs/use_scope"}, "valid_from": {"$ref": "#/$defs/timestamp"}, "valid_until": {"$ref": "#/$defs/nullable_timestamp"}, "actor_id": {"$ref": "#/$defs/id"}, "actor_type": {"const": "human"}, "authority": {"const": "human_final"}, "reason_code": {"$ref": "#/$defs/rights_reason"}, "reason": {"$ref": "#/$defs/reason_detail"}, "evidence_id": {"$ref": "#/$defs/id"}, "reviewed_at": {"$ref": "#/$defs/timestamp"}, "sequence": {"type": "integer", "minimum": 1, "maximum": 256}, "version": {"const": 1}, "supersedes": {"$ref": "#/$defs/nullable_id"}, "superseded_by": {"$ref": "#/$defs/nullable_id"}
      }
    },
    "lifecycle_event": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "type", "target_record_id", "actor_id", "actor_type", "authority", "reason_code", "reason", "evidence_ids", "recorded_at", "sequence", "version", "supersedes", "superseded_by", "previous_event_id"],
      "properties": {
        "event_id": {"$ref": "#/$defs/id"}, "type": {"enum": ["correction", "rights_revoked", "content_deleted", "takedown", "restore"]}, "target_record_id": {"$ref": "#/$defs/id"}, "actor_id": {"$ref": "#/$defs/id"}, "actor_type": {"enum": ["human", "system"]}, "authority": {"enum": ["human_final", "deterministic_policy"]}, "reason_code": {"enum": ["rights_corrected", "rights_revoked", "content_deleted", "source_takedown", "source_restored"]}, "reason": {"$ref": "#/$defs/reason_detail"}, "evidence_ids": {"$ref": "#/$defs/evidence_ids"}, "recorded_at": {"$ref": "#/$defs/timestamp"}, "sequence": {"type": "integer", "minimum": 2, "maximum": 256}, "version": {"const": 1}, "supersedes": {"$ref": "#/$defs/nullable_id"}, "superseded_by": {"$ref": "#/$defs/nullable_id"}, "previous_event_id": {"$ref": "#/$defs/nullable_id"}
      }
    },
    "applicability_record": {
      "type": "object", "additionalProperties": false,
      "required": ["actor_kind", "actor_id", "status", "proposed_status", "final_status", "authority", "reason_code", "evidence_id", "decided_at", "sequence", "version", "supersedes"],
      "properties": {
        "actor_kind": {"$ref": "#/$defs/actor_type"}, "actor_id": {"$ref": "#/$defs/id"}, "status": {"$ref": "#/$defs/applicability_status"}, "proposed_status": {"oneOf": [{"$ref": "#/$defs/applicability_outcome"}, {"type": "null"}]}, "final_status": {"oneOf": [{"$ref": "#/$defs/final_applicability_status"}, {"type": "null"}]}, "authority": {"$ref": "#/$defs/authority"}, "reason_code": {"$ref": "#/$defs/applicability_reason"}, "evidence_id": {"$ref": "#/$defs/id"}, "decided_at": {"$ref": "#/$defs/timestamp"}, "sequence": {"type": "integer", "minimum": 1, "maximum": 256}, "version": {"const": 1}, "supersedes": {"$ref": "#/$defs/nullable_id"}
      },
      "allOf": [
        {"if": {"properties": {"actor_kind": {"const": "human"}}, "required": ["actor_kind"]}, "then": {"properties": {"authority": {"const": "human_final"}, "proposed_status": {"type": "null"}, "final_status": {"$ref": "#/$defs/final_applicability_status"}}}},
        {"if": {"properties": {"actor_kind": {"enum": ["automation", "model", "system"]}}, "required": ["actor_kind"]}, "then": {"properties": {"authority": {"const": "proposal"}, "status": {"const": "proposed"}, "proposed_status": {"$ref": "#/$defs/applicability_outcome"}, "final_status": {"type": "null"}}}}
      ]
    },
    "expected_result": {
      "type": "object", "additionalProperties": false, "required": ["action_allowed", "applicability_status", "reason_code", "retrievable"],
      "properties": {"action_allowed": {"type": "boolean"}, "applicability_status": {"$ref": "#/$defs/applicability_status"}, "reason_code": {"$ref": "#/$defs/applicability_reason"}, "retrievable": {"type": "boolean"}}
    },
    "evidence_link": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "subject_id"],
      "properties": {"evidence_id": {"$ref": "#/$defs/id"}, "subject_id": {"$ref": "#/$defs/id"}}
    },
    "supersession_link": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
    "source_export_payload": {
      "type": "object", "additionalProperties": false,
      "required": ["provenance_id", "artifact_id", "evidence_start", "evidence_end", "quarantined", "source_content_hash", "evidence_quote_hash", "content_exported"],
      "properties": {
        "provenance_id": {"$ref": "#/$defs/id"}, "artifact_id": {"$ref": "#/$defs/id"},
        "evidence_start": {"type": "integer", "minimum": 0, "maximum": 2097152},
        "evidence_end": {"type": "integer", "minimum": 0, "maximum": 2097152},
        "quarantined": {"type": "boolean"}, "source_content_hash": {"$ref": "#/$defs/hash"},
        "evidence_quote_hash": {"$ref": "#/$defs/hash"}, "content_exported": {"const": false}
      }
    },
    "audit_record": {
      "type": "object", "additionalProperties": false,
      "required": ["record_id", "record_type", "schema_version", "subject_id", "actor_id", "actor_type", "authority", "reason_code", "reason_detail", "evidence_ids", "recorded_at", "sequence", "supersedes", "superseded_by", "lifecycle_target", "use_scope", "original_semantic_content_hash", "previous_event_id", "payload"],
      "properties": {
        "record_id": {"$ref": "#/$defs/id"}, "record_type": {"enum": ["source_provenance", "evidence_link", "rights_decision", "applicability_proposal", "applicability_decision", "lifecycle_correction", "lifecycle_revocation", "lifecycle_deletion", "lifecycle_takedown", "lifecycle_restore"]}, "schema_version": {"const": "adaivy.phase4-gate-record.v1"}, "subject_id": {"$ref": "#/$defs/id"}, "actor_id": {"$ref": "#/$defs/id"}, "actor_type": {"$ref": "#/$defs/actor_type"}, "authority": {"$ref": "#/$defs/authority"}, "reason_code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}, "reason_detail": {"$ref": "#/$defs/reason_detail"}, "evidence_ids": {"$ref": "#/$defs/evidence_ids"}, "recorded_at": {"$ref": "#/$defs/timestamp"}, "sequence": {"type": "integer", "minimum": 0, "maximum": 256}, "supersedes": {"$ref": "#/$defs/supersession_link"}, "superseded_by": {"$ref": "#/$defs/supersession_link"}, "lifecycle_target": {"$ref": "#/$defs/nullable_id"}, "use_scope": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/use"}}, "original_semantic_content_hash": {"$ref": "#/$defs/hash"}, "previous_event_id": {"$ref": "#/$defs/nullable_id"}, "payload": {"type": "object"}
      },
      "allOf": [
        {"if": {"properties": {"record_type": {"const": "source_provenance"}}, "required": ["record_type"]}, "then": {"properties": {"payload": {"$ref": "#/$defs/source_export_payload"}, "actor_type": {"const": "human"}, "authority": {"const": "source_provenance"}, "reason_code": {"const": "local_user_supplied"}}}},
        {"if": {"properties": {"record_type": {"const": "evidence_link"}}, "required": ["record_type"]}, "then": {"properties": {"payload": {"$ref": "#/$defs/evidence_link"}, "actor_type": {"const": "system"}, "authority": {"const": "source_provenance"}, "reason_code": {"const": "evidence_reference"}}}},
        {"if": {"properties": {"record_type": {"const": "rights_decision"}}, "required": ["record_type"]}, "then": {"properties": {"payload": {"$ref": "#/$defs/rights_decision"}, "actor_type": {"const": "human"}, "authority": {"const": "human_final"}, "reason_code": {"$ref": "#/$defs/rights_reason"}}}},
        {"if": {"properties": {"record_type": {"enum": ["applicability_proposal", "applicability_decision"]}}, "required": ["record_type"]}, "then": {"properties": {"payload": {"$ref": "#/$defs/applicability_record"}, "reason_code": {"$ref": "#/$defs/applicability_reason"}}}},
        {"if": {"properties": {"record_type": {"enum": ["lifecycle_correction", "lifecycle_revocation", "lifecycle_deletion", "lifecycle_takedown", "lifecycle_restore"]}}, "required": ["record_type"]}, "then": {"properties": {"payload": {"$ref": "#/$defs/lifecycle_event"}}}}
      ]
    },
    "export_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "record_schema_version", "id", "content_hash", "policy_versions", "fixture_hashes", "records"],
      "properties": {
        "schema_version": {"const": "adaivy.phase4-gate-candidate-export.v1"},
        "record_schema_version": {"const": "adaivy.phase4-gate-record.v1"},
        "id": {"const": "phase4-gate-candidate-export.v1"},
        "content_hash": {"$ref": "#/$defs/hash"},
        "policy_versions": {
          "const": ["phase4a-rights-v1", "phase4a-applicability-v1", "phase4a-lifecycle-v1"]
        },
        "fixture_hashes": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 256,
          "propertyNames": {"$ref": "#/$defs/id"},
          "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "records": {
          "type": "array",
          "maxItems": 256,
          "items": {"$ref": "#/$defs/audit_record"}
        }
      }
    }
  }
}
