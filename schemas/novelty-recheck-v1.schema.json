{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaivy.example/schemas/novelty-recheck-v1.schema.json",
  "title": "AdaIvy novelty re-check",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "policy_id", "recheck_id", "checkpoint", "subject_id",
    "subject_hash", "next_action_id", "performed_by", "performer_kind",
    "performed_at", "search_protocol", "evidence_refs", "outcome", "prior_art", "limitations",
    "previous_recheck_id", "previous_recheck_hash", "creates_mathematical_warrant",
    "automatic_novelty_authority", "content_hash"
  ],
  "properties": {
    "schema_version": {"const": "adaivy.novelty-recheck.v1"},
    "policy_id": {"const": "novelty-recheck-two-checkpoint-v1"},
    "recheck_id": {"$ref": "#/$defs/id"},
    "checkpoint": {"enum": ["before_research", "before_announcement"]},
    "subject_id": {"$ref": "#/$defs/id"},
    "subject_hash": {"$ref": "#/$defs/hash"},
    "next_action_id": {"$ref": "#/$defs/id"},
    "performed_by": {"$ref": "#/$defs/id"},
    "performer_kind": {"const": "human"},
    "performed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$"},
    "search_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_id", "query_terms", "searched_sources", "equivalence_checks"],
      "properties": {
        "protocol_id": {"$ref": "#/$defs/id"},
        "query_terms": {"$ref": "#/$defs/nonemptyStrings"},
        "searched_sources": {"$ref": "#/$defs/nonemptyStrings"},
        "equivalence_checks": {"$ref": "#/$defs/nonemptyStrings"}
      }
    },
    "evidence_refs": {
      "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["ref_id", "content_hash"],
        "properties": {"ref_id": {"$ref": "#/$defs/id"}, "content_hash": {"$ref": "#/$defs/hash"}}
      }
    },
    "outcome": {"enum": ["prior_art_found", "not_found_under_protocol", "inconclusive"]},
    "prior_art": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relationship", "resolution", "verification_status", "report_classification",
        "target_resolution_status", "novelty_status", "creates_mathematical_warrant"
      ],
      "properties": {
        "relationship": {
          "enum": [
            "not_applicable", "same_result", "equivalent_result",
            "stronger_prior_result", "weaker_prior_result", "overlapping_result",
            "unresolved"
          ]
        },
        "resolution": {
          "enum": ["not_applicable", "proof", "refutation", "other_resolution", "unresolved"]
        },
        "verification_status": {
          "enum": ["not_applicable", "source_report_only", "independently_verified", "unresolved"]
        },
        "report_classification": {
          "enum": [
            "no_prior_art_found_under_protocol", "prior_art_search_inconclusive",
            "reported_prior_resolution", "independent_verification",
            "extension_of_prior_result", "related_to_prior_result",
            "prior_art_relationship_unresolved"
          ]
        },
        "target_resolution_status": {
          "enum": [
            "not_assessed", "reported_proved", "reported_refuted",
            "reported_resolved_other", "already_proved", "already_refuted",
            "already_resolved_other", "not_resolved_by_prior_result", "unresolved"
          ]
        },
        "novelty_status": {"const": "not_assessed"},
        "creates_mathematical_warrant": {"const": false}
      }
    },
    "limitations": {"$ref": "#/$defs/nonemptyStrings"},
    "previous_recheck_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
    "previous_recheck_hash": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
    "creates_mathematical_warrant": {"const": false},
    "automatic_novelty_authority": {"const": false},
    "content_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nonemptyStrings": {
      "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
